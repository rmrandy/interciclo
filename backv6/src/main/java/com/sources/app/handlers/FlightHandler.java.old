package com.sources.app.handlers;

import com.google.gson.Gson;
import com.google.gson.GsonBuilder;
import com.sources.app.entities.Flight;
import com.sources.app.entities.Route;
import com.sources.app.entities.Aircraft;
import com.sources.app.entities.Aeropuerto;
import com.sources.app.util.HibernateUtil;
import jakarta.persistence.Query;
import org.hibernate.Session;

import java.time.LocalDate;
import java.time.LocalTime;
import java.util.List;
import java.util.Map;
import java.util.HashMap;

public class FlightHandler {
    private final Gson gson = new GsonBuilder()
        .setDateFormat("yyyy-MM-dd")
        .create();

    public String listFlights() {
        try (Session session = HibernateUtil.getSessionFactory().openSession()) {
            String hql = """
                SELECT f, r, a, orig, dest 
                FROM Flight f 
                JOIN f.route r 
                JOIN f.aircraft a 
                JOIN r.originAirport orig 
                JOIN r.destinationAirport dest 
                WHERE f.status = 'SCHEDULED' 
                AND f.departureDate >= :today
                ORDER BY f.departureDate, f.departureTime
                """;
            
            Query query = session.createQuery(hql);
            query.setParameter("today", LocalDate.now());
            
            @SuppressWarnings("unchecked")
            List<Object[]> results = query.getResultList();
            
            List<Map<String, Object>> flightList = new java.util.ArrayList<>();
            
            for (Object[] result : results) {
                Flight flight = (Flight) result[0];
                Route route = (Route) result[1];
                Aircraft aircraft = (Aircraft) result[2];
                Aeropuerto originAirport = (Aeropuerto) result[3];
                Aeropuerto destAirport = (Aeropuerto) result[4];
                
                Map<String, Object> flightData = new HashMap<>();
                flightData.put("id", flight.getIdFlight());
                flightData.put("flightNumber", flight.getFlightNumber());
                flightData.put("origin", originAirport.getCity());
                flightData.put("destination", destAirport.getCity());
                flightData.put("originCode", originAirport.getCodigoAeropuerto());
                flightData.put("destinationCode", destAirport.getCodigoAeropuerto());
                flightData.put("departureTime", flight.getDepartureTime().toString());
                flightData.put("arrivalTime", flight.getArrivalTime().toString());
                flightData.put("date", flight.getDepartureDate().toString());
                flightData.put("price", flight.getBasePrice());
                flightData.put("aircraft", aircraft.getAircraftModel());
                flightData.put("availableSeats", flight.getAvailableSeats());
                flightData.put("status", flight.getStatus());
                
                // Calcular duración
                long durationMinutes = route.getEstimatedDurationMinutes();
                String duration = String.format("%dh %02dm", durationMinutes / 60, durationMinutes % 60);
                flightData.put("duration", duration);
                
                // Información adicional
                flightData.put("stops", 0); // Por ahora todos son directos
                flightData.put("baggage", "23kg incluido");
                flightData.put("meal", getMealType(flight.getDepartureTime()));
                flightData.put("airline", "AeroLinea");
                
                flightList.add(flightData);
            }
            
            return gson.toJson(flightList);
        } catch (Exception e) {
            e.printStackTrace();
            return gson.toJson(Map.of("error", "Error al cargar vuelos: " + e.getMessage()));
        }
    }

    public String getFlightById(String flightId) {
        try (Session session = HibernateUtil.getSessionFactory().openSession()) {
            String hql = """
                SELECT f, r, a, orig, dest 
                FROM Flight f 
                JOIN f.route r 
                JOIN f.aircraft a 
                JOIN r.originAirport orig 
                JOIN r.destinationAirport dest 
                WHERE f.idFlight = :flightId
                """;
            
            Query query = session.createQuery(hql);
            query.setParameter("flightId", Integer.parseInt(flightId));
            
            @SuppressWarnings("unchecked")
            List<Object[]> results = query.getResultList();
            
            if (results.isEmpty()) {
                return gson.toJson(Map.of("error", "Vuelo no encontrado"));
            }
            
            Object[] result = results.get(0);
            Flight flight = (Flight) result[0];
            Route route = (Route) result[1];
            Aircraft aircraft = (Aircraft) result[2];
            Aeropuerto originAirport = (Aeropuerto) result[3];
            Aeropuerto destAirport = (Aeropuerto) result[4];
            
            Map<String, Object> flightData = new HashMap<>();
            flightData.put("id", flight.getIdFlight());
            flightData.put("flightNumber", flight.getFlightNumber());
            flightData.put("origin", originAirport.getCity());
            flightData.put("destination", destAirport.getCity());
            flightData.put("originCode", originAirport.getCodigoAeropuerto());
            flightData.put("destinationCode", destAirport.getCodigoAeropuerto());
            flightData.put("departureTime", flight.getDepartureTime().toString());
            flightData.put("arrivalTime", flight.getArrivalTime().toString());
            flightData.put("date", flight.getDepartureDate().toString());
            flightData.put("price", flight.getBasePrice());
            flightData.put("aircraft", aircraft.getAircraftModel());
            flightData.put("availableSeats", flight.getAvailableSeats());
            flightData.put("status", flight.getStatus());
            
            // Información detallada adicional
            long durationMinutes = route.getEstimatedDurationMinutes();
            String duration = String.format("%dh %02dm", durationMinutes / 60, durationMinutes % 60);
            flightData.put("duration", duration);
            flightData.put("stops", 0);
            flightData.put("baggage", "23kg incluido");
            flightData.put("meal", getMealType(flight.getDepartureTime()));
            flightData.put("airline", "AeroLinea");
            flightData.put("gate", "A" + (flight.getIdFlight() + 10));
            flightData.put("terminal", flight.getIdFlight() % 2 == 0 ? "Terminal 1" : "Terminal 2");
            
            return gson.toJson(flightData);
        } catch (Exception e) {
            e.printStackTrace();
            return gson.toJson(Map.of("error", "Error al cargar detalles del vuelo: " + e.getMessage()));
        }
    }

    public String searchFlights(String origin, String destination, String date) {
        try (Session session = HibernateUtil.getSessionFactory().openSession()) {
            String hql = """
                SELECT f, r, a, orig, dest 
                FROM Flight f 
                JOIN f.route r 
                JOIN f.aircraft a 
                JOIN r.originAirport orig 
                JOIN r.destinationAirport dest 
                WHERE f.status = 'SCHEDULED' 
                AND f.availableSeats > 0
                """;
            
            if (origin != null && !origin.isEmpty()) {
                hql += " AND (UPPER(orig.city) LIKE UPPER(:origin) OR UPPER(orig.codigoAeropuerto) LIKE UPPER(:origin))";
            }
            if (destination != null && !destination.isEmpty()) {
                hql += " AND (UPPER(dest.city) LIKE UPPER(:destination) OR UPPER(dest.codigoAeropuerto) LIKE UPPER(:destination))";
            }
            if (date != null && !date.isEmpty()) {
                hql += " AND f.departureDate = :date";
            }
            
            hql += " ORDER BY f.departureDate, f.departureTime";
            
            Query query = session.createQuery(hql);
            
            if (origin != null && !origin.isEmpty()) {
                query.setParameter("origin", "%" + origin + "%");
            }
            if (destination != null && !destination.isEmpty()) {
                query.setParameter("destination", "%" + destination + "%");
            }
            if (date != null && !date.isEmpty()) {
                query.setParameter("date", LocalDate.parse(date));
            }
            
            @SuppressWarnings("unchecked")
            List<Object[]> results = query.getResultList();
            
            List<Map<String, Object>> flightList = new java.util.ArrayList<>();
            
            for (Object[] result : results) {
                Flight flight = (Flight) result[0];
                Route route = (Route) result[1];
                Aircraft aircraft = (Aircraft) result[2];
                Aeropuerto originAirport = (Aeropuerto) result[3];
                Aeropuerto destAirport = (Aeropuerto) result[4];
                
                Map<String, Object> flightData = new HashMap<>();
                flightData.put("id", flight.getIdFlight());
                flightData.put("flightNumber", flight.getFlightNumber());
                flightData.put("origin", originAirport.getCity());
                flightData.put("destination", destAirport.getCity());
                flightData.put("originCode", originAirport.getCodigoAeropuerto());
                flightData.put("destinationCode", destAirport.getCodigoAeropuerto());
                flightData.put("departureTime", flight.getDepartureTime().toString());
                flightData.put("arrivalTime", flight.getArrivalTime().toString());
                flightData.put("date", flight.getDepartureDate().toString());
                flightData.put("price", flight.getBasePrice());
                flightData.put("aircraft", aircraft.getAircraftModel());
                flightData.put("availableSeats", flight.getAvailableSeats());
                flightData.put("status", flight.getStatus());
                
                long durationMinutes = route.getEstimatedDurationMinutes();
                String duration = String.format("%dh %02dm", durationMinutes / 60, durationMinutes % 60);
                flightData.put("duration", duration);
                flightData.put("stops", 0);
                flightData.put("baggage", "23kg incluido");
                flightData.put("meal", getMealType(flight.getDepartureTime()));
                flightData.put("airline", "AeroLinea");
                
                flightList.add(flightData);
            }
            
            return gson.toJson(flightList);
        } catch (Exception e) {
            e.printStackTrace();
            return gson.toJson(Map.of("error", "Error en búsqueda de vuelos: " + e.getMessage()));
        }
    }

    private String getMealType(LocalTime departureTime) {
        int hour = departureTime.getHour();
        if (hour >= 6 && hour < 11) {
            return "Desayuno incluido";
        } else if (hour >= 11 && hour < 15) {
            return "Almuerzo incluido";
        } else if (hour >= 18 && hour < 22) {
            return "Cena incluida";
        } else {
            return "Snack incluido";
        }
    }
}


