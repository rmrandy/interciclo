<?xml version="1.0" encoding="UTF-8"?>
<hibernate-configuration>
    <session-factory>
        <!-- JDBC Database connection settings -->
        <property name="hibernate.connection.driver_class">oracle.jdbc.driver.OracleDriver</property>
        <!-- Conexión al esquema AEROLINEA existente -->
        <property name="hibernate.connection.url">jdbc:oracle:thin:@//64.225.58.196:1521/XEPDB1</property>
        <property name="hibernate.connection.username">AEROLINEA</property>
        <property name="hibernate.connection.password">123</property>
        
        <!-- Connection pool settings (optional) -->
        <property name="hibernate.connection.pool_size">10</property>
        
        <!-- SQL dialect for Oracle -->
        <property name="hibernate.dialect">org.hibernate.dialect.OracleDialect</property>
        
        <!-- Show SQL statements in the console -->
        <property name="show_sql">true</property>
        
        <!-- Usar esquema existente sin modificar las tablas -->
        <property name="hibernate.hbm2ddl.auto">none</property>
        
        <!-- Configuraciones para manejar conexiones cerradas -->
        <property name="hibernate.connection.autoCommit">false</property>
        <property name="hibernate.connection.isolation">2</property>
        <property name="hibernate.connection.release_mode">after_transaction</property>
        
        <!-- Configuraciones de timeout -->
        <property name="hibernate.jdbc.batch_size">20</property>
        <property name="hibernate.jdbc.fetch_size">20</property>
        <property name="hibernate.jdbc.batch_versioned_data">true</property>

        <!-- Optionally, configure a c3p0 connection pool -->
        <property name="hibernate.c3p0.min_size">5</property>
        <property name="hibernate.c3p0.max_size">20</property>
        <property name="hibernate.c3p0.timeout">300</property>
        <property name="hibernate.c3p0.max_statements">50</property>
        <property name="hibernate.c3p0.idle_test_period">3000</property>

        <!-- Mapping your entity classes -->
        <!-- Solo mapeos necesarios para Aerolínea y Usuarios -->
        <mapping class="com.sources.app.entities.Aeropuerto"/>
        <mapping class="com.sources.app.entities.City"/>
        <mapping class="com.sources.app.entities.Aircraft"/>
        <mapping class="com.sources.app.entities.Route"/>
        <mapping class="com.sources.app.entities.Flight"/>
        <mapping class="com.sources.app.entities.Ticket"/>
        <mapping class="com.sources.app.entities.Booking"/>
        <mapping class="com.sources.app.entities.User"/>
        <mapping class="com.sources.app.entities.UserRole"/>
        
        <!-- Nuevas entidades para gestión completa de vuelos -->
        <mapping class="com.sources.app.entities.FlightLeg"/>
        <mapping class="com.sources.app.entities.FlightInventory"/>
        <mapping class="com.sources.app.entities.FlightFare"/>
        <mapping class="com.sources.app.entities.FlightReview"/>
        <!-- Entidad para analítica de clics -->
        <mapping class="com.sources.app.entities.ClickEvent"/>

    </session-factory>
</hibernate-configuration>