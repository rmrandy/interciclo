package com.sources.app.handlers;

import com.google.gson.Gson;
import com.google.gson.GsonBuilder;
import com.sources.app.entities.Booking;
import com.sources.app.entities.Ticket;
import com.sources.app.entities.Flight;
import com.sources.app.entities.Route;
import com.sources.app.entities.Aircraft;
import com.sources.app.entities.Aeropuerto;
import com.sources.app.entities.User;
import com.sources.app.util.HibernateUtil;
import jakarta.persistence.Query;
import org.hibernate.Session;
import org.hibernate.Transaction;

import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.util.List;
import java.util.Map;
import java.util.HashMap;
import java.util.UUID;

public class BookingHandler {
    private final Gson gson = new GsonBuilder()
        .setDateFormat("yyyy-MM-dd'T'HH:mm:ss")
        .create();

    public String getUserBookings(String userId) {
        try (Session session = HibernateUtil.getSessionFactory().openSession()) {
            String hql = """
                SELECT b, t, f, r, a, orig, dest 
                FROM Booking b 
                JOIN b.ticket t 
                JOIN t.flight f 
                JOIN f.route r 
                JOIN f.aircraft a 
                JOIN r.originAirport orig 
                JOIN r.destinationAirport dest 
                WHERE b.user.idUser = :userId
                ORDER BY b.bookingDate DESC
                """;
            
            Query query = session.createQuery(hql);
            query.setParameter("userId", Integer.parseInt(userId));
            
            @SuppressWarnings("unchecked")
            List<Object[]> results = query.getResultList();
            
            List<Map<String, Object>> bookingList = new java.util.ArrayList<>();
            
            for (Object[] result : results) {
                Booking booking = (Booking) result[0];
                Ticket ticket = (Ticket) result[1];
                Flight flight = (Flight) result[2];
                Route route = (Route) result[3];
                Aircraft aircraft = (Aircraft) result[4];
                Aeropuerto originAirport = (Aeropuerto) result[5];
                Aeropuerto destAirport = (Aeropuerto) result[6];
                
                Map<String, Object> bookingData = new HashMap<>();
                bookingData.put("id", booking.getConfirmationNumber());
                bookingData.put("status", booking.getStatus().toLowerCase());
                bookingData.put("confirmationNumber", booking.getConfirmationNumber());
                bookingData.put("bookingDate", booking.getBookingDate().toString());
                bookingData.put("totalPrice", booking.getTotalAmount().doubleValue());
                
                // Información del vuelo
                Map<String, Object> flightData = new HashMap<>();
                flightData.put("flightNumber", flight.getFlightNumber());
                flightData.put("origin", originAirport.getCity());
                flightData.put("destination", destAirport.getCity());
                flightData.put("departureTime", flight.getDepartureTime().toString());
                flightData.put("arrivalTime", flight.getArrivalTime().toString());
                flightData.put("date", flight.getDepartureDate().toString());
                flightData.put("aircraft", aircraft.getAircraftModel());
                
                bookingData.put("flight", flightData);
                bookingData.put("passengers", 1); // Por simplicidad, 1 pasajero por ticket
                bookingData.put("seatNumbers", List.of(ticket.getSeatNumber()));
                
                // Determinar si se puede cancelar/modificar
                boolean canCancel = "CONFIRMED".equals(booking.getStatus()) && 
                                  flight.getDepartureDate().isAfter(java.time.LocalDate.now());
                boolean canModify = canCancel;
                
                bookingData.put("canCancel", canCancel);
                bookingData.put("canModify", canModify);
                
                bookingList.add(bookingData);
            }
            
            return gson.toJson(bookingList);
        } catch (Exception e) {
            e.printStackTrace();
            return gson.toJson(Map.of("error", "Error al cargar reservas: " + e.getMessage()));
        }
    }

    public String getBookingById(String bookingId) {
        try (Session session = HibernateUtil.getSessionFactory().openSession()) {
            String hql = """
                SELECT b, t, f, r, a, orig, dest, u 
                FROM Booking b 
                JOIN b.ticket t 
                JOIN t.flight f 
                JOIN f.route r 
                JOIN f.aircraft a 
                JOIN r.originAirport orig 
                JOIN r.destinationAirport dest 
                JOIN b.user u 
                WHERE b.confirmationNumber = :bookingId
                """;
            
            Query query = session.createQuery(hql);
            query.setParameter("bookingId", bookingId);
            
            @SuppressWarnings("unchecked")
            List<Object[]> results = query.getResultList();
            
            if (results.isEmpty()) {
                return gson.toJson(Map.of("error", "Reserva no encontrada"));
            }
            
            Object[] result = results.get(0);
            Booking booking = (Booking) result[0];
            Ticket ticket = (Ticket) result[1];
            Flight flight = (Flight) result[2];
            Route route = (Route) result[3];
            Aircraft aircraft = (Aircraft) result[4];
            Aeropuerto originAirport = (Aeropuerto) result[5];
            Aeropuerto destAirport = (Aeropuerto) result[6];
            User user = (User) result[7];
            
            Map<String, Object> bookingData = new HashMap<>();
            bookingData.put("id", booking.getConfirmationNumber());
            bookingData.put("status", booking.getStatus().toLowerCase());
            bookingData.put("confirmationNumber", booking.getConfirmationNumber());
            bookingData.put("bookingDate", booking.getBookingDate().toString());
            bookingData.put("totalPrice", booking.getTotalAmount().doubleValue());
            bookingData.put("paymentMethod", "Tarjeta de crédito");
            
            // Información del vuelo
            Map<String, Object> flightData = new HashMap<>();
            flightData.put("flightNumber", flight.getFlightNumber());
            flightData.put("origin", originAirport.getCity());
            flightData.put("destination", destAirport.getCity());
            flightData.put("departureTime", flight.getDepartureTime().toString());
            flightData.put("arrivalTime", flight.getArrivalTime().toString());
            flightData.put("date", flight.getDepartureDate().toString());
            flightData.put("aircraft", aircraft.getAircraftModel());
            flightData.put("gate", "A" + (flight.getIdFlight() + 10));
            flightData.put("terminal", flight.getIdFlight() % 2 == 0 ? "Terminal 1" : "Terminal 2");
            
            bookingData.put("flight", flightData);
            bookingData.put("passengers", 1);
            bookingData.put("seatNumbers", List.of(ticket.getSeatNumber()));
            bookingData.put("specialRequests", "Comida estándar");
            
            return gson.toJson(bookingData);
        } catch (Exception e) {
            e.printStackTrace();
            return gson.toJson(Map.of("error", "Error al cargar detalles de la reserva: " + e.getMessage()));
        }
    }

    public String createBooking(String requestBody) {
        try (Session session = HibernateUtil.getSessionFactory().openSession()) {
            Transaction transaction = session.beginTransaction();
            
            // Parse del JSON de entrada
            @SuppressWarnings("unchecked")
            Map<String, Object> bookingRequest = gson.fromJson(requestBody, Map.class);
            
            String flightId = bookingRequest.get("flightId").toString();
            String userId = bookingRequest.get("userId").toString();
            int passengers = ((Double) bookingRequest.get("passengers")).intValue();
            String seatPreference = (String) bookingRequest.get("seatPreference");
            
            // Obtener el vuelo
            Flight flight = session.get(Flight.class, Integer.parseInt(flightId));
            if (flight == null) {
                return gson.toJson(Map.of("error", "Vuelo no encontrado"));
            }
            
            // Verificar disponibilidad
            if (flight.getAvailableSeats() < passengers) {
                return gson.toJson(Map.of("error", "No hay suficientes asientos disponibles"));
            }
            
            // Obtener el usuario
            User user = session.get(User.class, Integer.parseInt(userId));
            if (user == null) {
                return gson.toJson(Map.of("error", "Usuario no encontrado"));
            }
            
            // Generar número de confirmación
            String confirmationNumber = UUID.randomUUID().toString().substring(0, 8).toUpperCase();
            
            // Crear ticket
            Ticket ticket = new Ticket();
            ticket.setFlight(flight);
            ticket.setUser(user);
            ticket.setSeatNumber(generateSeatNumber(seatPreference, flight.getIdFlight()));
            ticket.setTicketClass("ECONOMY");
            ticket.setFare(flight.getBasePrice());
            ticket.setStatus("CONFIRMED");
            ticket.setBookingDate(LocalDateTime.now());
            ticket.setCreatedAt(LocalDateTime.now());
            ticket.setUpdatedAt(LocalDateTime.now());
            
            session.persist(ticket);
            session.flush(); // Para obtener el ID generado
            
            // Crear booking
            Booking booking = new Booking();
            booking.setUser(user);
            booking.setTicket(ticket);
            booking.setConfirmationNumber(confirmationNumber);
            booking.setTotalAmount(flight.getBasePrice().multiply(BigDecimal.valueOf(passengers)));
            booking.setStatus("CONFIRMED");
            booking.setBookingDate(LocalDateTime.now());
            booking.setCreatedAt(LocalDateTime.now());
            booking.setUpdatedAt(LocalDateTime.now());
            
            session.persist(booking);
            
            // Actualizar asientos disponibles
            flight.setAvailableSeats(flight.getAvailableSeats() - passengers);
            session.merge(flight);
            
            transaction.commit();
            
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("bookingId", confirmationNumber);
            response.put("message", "Reserva creada exitosamente");
            
            return gson.toJson(response);
            
        } catch (Exception e) {
            e.printStackTrace();
            return gson.toJson(Map.of("error", "Error al crear la reserva: " + e.getMessage()));
        }
    }

    public String cancelBooking(String bookingId, String userId) {
        try (Session session = HibernateUtil.getSessionFactory().openSession()) {
            Transaction transaction = session.beginTransaction();
            
            // Obtener la reserva
            String hql = "FROM Booking WHERE confirmationNumber = :bookingId AND user.idUser = :userId";
            Query query = session.createQuery(hql, Booking.class);
            query.setParameter("bookingId", bookingId);
            query.setParameter("userId", Integer.parseInt(userId));
            
            @SuppressWarnings("unchecked")
            List<Booking> bookings = query.getResultList();
            
            if (bookings.isEmpty()) {
                return gson.toJson(Map.of("error", "Reserva no encontrada"));
            }
            
            Booking booking = bookings.get(0);
            
            if (!"CONFIRMED".equals(booking.getStatus())) {
                return gson.toJson(Map.of("error", "La reserva no se puede cancelar"));
            }
            
            // Actualizar estado
            booking.setStatus("CANCELLED");
            booking.setUpdatedAt(LocalDateTime.now());
            session.merge(booking);
            
            // Actualizar ticket
            Ticket ticket = booking.getTicket();
            ticket.setStatus("CANCELLED");
            ticket.setUpdatedAt(LocalDateTime.now());
            session.merge(ticket);
            
            // Liberar asiento en el vuelo
            Flight flight = ticket.getFlight();
            flight.setAvailableSeats(flight.getAvailableSeats() + 1);
            session.merge(flight);
            
            transaction.commit();
            
            return gson.toJson(Map.of("success", true, "message", "Reserva cancelada exitosamente"));
            
        } catch (Exception e) {
            e.printStackTrace();
            return gson.toJson(Map.of("error", "Error al cancelar la reserva: " + e.getMessage()));
        }
    }

    private String generateSeatNumber(String preference, int flightId) {
        // Generar número de asiento basado en la preferencia
        String row = String.valueOf(10 + (flightId % 20)); // Filas 10-29
        String letter;
        
        switch (preference) {
            case "window":
                letter = (flightId % 2 == 0) ? "A" : "F";
                break;
            case "aisle":
                letter = (flightId % 2 == 0) ? "C" : "D";
                break;
            case "middle":
                letter = "B";
                break;
            default: // any
                char[] letters = {'A', 'B', 'C', 'D', 'E', 'F'};
                letter = String.valueOf(letters[flightId % letters.length]);
                break;
        }
        
        return row + letter;
    }
}


